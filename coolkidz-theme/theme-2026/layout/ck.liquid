<!doctype html>
{%- comment -%}
  Coolkidz 2026 layout. Bright, modern, inviting: white ground, pastel tints
  from the Coolkidz logo colours, Sora + Figtree. Used by every shop and
  business template; customer-account, gift-card and password pages keep the
  original theme layout. Nothing from the old theme's CSS loads here.
{%- endcomment -%}
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#ffffff">
  {%- comment -%} Old pages redirect to their new homes (Theme settings > Coolkidz 2026 > Redirects). {%- endcomment -%}
  {%- assign ck_to = '' -%}
  {%- assign ck_lines = settings.ck_redirects | newline_to_br | split: '<br />' -%}
  {%- for l in ck_lines -%}{%- assign ck_p = l | strip | split: '|' -%}{%- if ck_p.size > 1 -%}{%- assign ck_from = ck_p[0] | strip -%}{%- if request.path == ck_from -%}{%- assign ck_to = ck_p[1] | strip -%}{%- break -%}{%- endif -%}{%- endif -%}{%- endfor -%}
  {%- if ck_to != '' and request.design_mode == false -%}
    <meta http-equiv="refresh" content="0; url={{ ck_to }}"><meta name="robots" content="noindex"><script>location.replace({{ ck_to | json }});</script>
  {%- endif -%}
  {%- if template.name == '404' -%}
    <script>(function(){var m={};{%- for l in ck_lines -%}{%- assign ck_p = l | strip | split: '|' -%}{%- if ck_p.size > 1 -%}m[{{ ck_p[0] | strip | json }}]={{ ck_p[1] | strip | json }};{%- endif -%}{%- endfor -%}var t=m[location.pathname.replace(/\/$/,'')];if(t)location.replace(t);})();</script>
  {%- endif -%}
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}
  {%- liquid
    assign ck_title = page_title
    assign ck_desc = page_description
    if template.name == 'index'
      assign ck_title = settings.ck_home_title | default: page_title
      assign ck_desc = settings.ck_home_desc | default: page_description
    elsif template.name == 'collection' and collection.handle == 'vendors'
      assign ck_title = 'Shop ' | append: collection.title | append: ' in Australia | Official stockist'
      if ck_desc == blank
        assign ck_desc = 'Shop the ' | append: collection.title | append: ' range at Coolkidz, the official Australian distributor. Full Australian warranty, one help desk, and mix brands in one order to save.'
      endif
    elsif template.name == 'collection' and collection.handle == 'all'
      assign ck_title = 'Shop all baby brands: UPPAbaby, Nanit, Gaia Baby & more'
      if ck_desc == blank
        assign ck_desc = 'Every product from the Coolkidz family of baby brands in one place: prams, nursery furniture, monitors, sleep, travel and care. Mix brands in one order and save.'
      endif
    elsif template.name == 'blog'
      assign ck_title = 'Journal: guides for the first years'
      if ck_desc == blank
        assign ck_desc = 'Guides from Coolkidz on prams, sleep, nursery set-up, travel and caring for you and your baby.'
      endif
    endif
    if ck_desc == blank
      assign ck_desc = settings.ck_home_desc
    endif
  -%}
  <title>{{ ck_title }}{% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}{% unless ck_title contains 'Coolkidz' %} &ndash; {{ shop.name }}{% endunless %}</title>
  {%- if ck_desc != blank -%}<meta name="description" content="{{ ck_desc | strip_html | escape | truncate: 300 }}">{%- endif -%}
  {%- render 'meta-tags' -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700&family=Figtree:wght@400;500;600;700&display=swap">
  {{ 'ck-base.css' | asset_url | stylesheet_tag }}
  {%- if template.name == 'index' -%}<link rel="preload" as="image" href="{{ 'ck-t1.jpg' | asset_img_url: '450x' }}" imagesrcset="{{ 'ck-t1.jpg' | asset_img_url: '450x' }} 450w, {{ 'ck-t1.jpg' | asset_img_url: '700x' }} 700w" imagesizes="(min-width: 900px) 33vw, 50vw" fetchpriority="high">{%- endif -%}
  {%- if template.name == 'product' and product.featured_media -%}<link rel="preload" as="image" href="{{ product.featured_media | image_url: width: 800 }}" imagesrcset="{{ product.featured_media | image_url: width: 400 }} 400w, {{ product.featured_media | image_url: width: 600 }} 600w, {{ product.featured_media | image_url: width: 800 }} 800w, {{ product.featured_media | image_url: width: 1200 }} 1200w" imagesizes="(min-width: 900px) 55vw, 88vw" fetchpriority="high">{%- endif -%}
  <script>window.ckShip = {{ settings.ck_free_ship | default: 100 | times: 100 }};</script>
  <script>window.ckMix = { enabled: {{ settings.ck_mix_enabled | default: true | json }}, tiers: [0, 0, {{ settings.ck_mix_2 | default: 5 }}, {{ settings.ck_mix_3 | default: 10 }}, {{ settings.ck_mix_4 | default: 15 }}] };</script>
  <script src="{{ 'ck-base.js' | asset_url }}" defer></script>
  {%- if template.name == 'index' -%}
  <script type="application/ld+json">{"@context":"https://schema.org","@graph":[
    {"@type":"Organization","@id":{{ shop.url | append: '/#org' | json }},"name":"Coolkidz Australia","legalName":"Coolkidz Australia Pty Ltd","url":{{ shop.url | json }},"logo":{{ 'ck-logo.png' | asset_url | prepend: 'https:' | json }},
     "telephone":"+61 1300 722 302","email":"info@coolkidz.com.au",
     "address":{"@type":"PostalAddress","streetAddress":"1 Beyer Road","addressLocality":"Braeside","addressRegion":"VIC","postalCode":"3195","addressCountry":"AU"},
     "sameAs":["https://www.facebook.com/Coolkidz.Aus","https://www.instagram.com/coolkidz_australia"]},
    {"@type":"WebSite","@id":{{ shop.url | append: '/#site' | json }},"url":{{ shop.url | json }},"name":"Coolkidz Australia","publisher":{"@id":{{ shop.url | append: '/#org' | json }}},
     "potentialAction":{"@type":"SearchAction","target":"{{ shop.url }}/search?type=product&q={q}","query-input":"required name=q"}}]}</script>
  {%- endif -%}
  {{ content_for_header }}
  {{ shop.metafields.foxtheme.code_head.value }}
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=AW-17013900607"></script>
  <script>window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', 'AW-17013900607');</script>
  {%- if template.suffix == 'visitor-signin' -%}<meta name="robots" content="noindex">{%- endif -%}
</head>
<body class="ck t-{{ template.name }}{% if template.suffix %} s-{{ template.suffix }}{% endif %}">
  {{ shop.metafields.foxtheme.code_body.value }}
  <a class="ck-skip" href="#main">Skip to content</a>
  {% sections 'ck-header-group' %}
  <main id="main" tabindex="-1">
    {{ content_for_layout }}
  </main>
  {% sections 'ck-footer-group' %}
  <div class="ck-toast" id="ck-toast" role="status" aria-live="polite" hidden></div>
  {%- if template.name == 'index' and settings.ck_welcome_enabled -%}{%- render 'ck-welcome' -%}{%- endif -%}
  {%- if settings.ck_ask_enabled -%}{%- render 'ck-assistant' -%}{%- endif -%}
</body>
</html>
