{%- comment -%} Product card with a quick "Add to bag" for single-variant products. {%- endcomment -%}
{%- assign v = product.selected_or_first_available_variant -%}
<article class="ck-card">
  <div class="im">
    <a href="{{ product.url }}" aria-label="{{ product.title | escape }}"></a>
    {%- if product.featured_image -%}{%- assign ck_alt = product.featured_image.alt | default: product.title -%}{{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '240,360,480,600', sizes: '(min-width: 1100px) 22vw, (min-width: 900px) 30vw, 45vw', alt: ck_alt, class: 'a' }}{%- endif -%}
    {%- if product.images.size > 1 -%}{{ product.images[1] | image_url: width: 600 | image_tag: loading: 'lazy', widths: '240,360,480,600', sizes: '(min-width: 1100px) 22vw, (min-width: 900px) 30vw, 45vw', alt: '', class: 'b' }}{%- endif -%}
    {%- assign ck_best = false -%}{%- for c in product.collections -%}{%- if c.handle == 'best-sellers' -%}{%- assign ck_best = true -%}{%- endif -%}{%- endfor -%}
    <span class="badges">
      {%- unless product.available -%}<span class="badge">Sold out</span>{%- else -%}
        {%- if product.tags contains 'ck-new' -%}<span class="badge new">New</span>{%- elsif ck_best -%}<span class="badge best">Best seller</span>{%- endif -%}
        {%- if product.variants.size > 1 -%}<span class="badge">{{ product.variants.size }} options</span>{%- endif -%}
      {%- endunless -%}
    </span>
    {%- render 'ck-save', product: product -%}
    {%- if product.available -%}
      <div class="quick">
        {%- if product.has_only_default_variant -%}
          <form action="{{ routes.cart_add_url }}" method="post" data-ck-add="{{ product.title | escape }} added">
            <input type="hidden" name="id" value="{{ v.id }}">
            <button class="ck-btn small" type="submit">Add to bag</button>
          </form>
        {%- else -%}
          <a class="ck-btn small" href="{{ product.url }}">Choose options</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
  <div class="meta">
    <span class="br">{{ product.vendor | remove: ' Wagons Australia' | remove: ' Australia' }}</span>
    <h3><a href="{{ product.url }}">{{ product.title | remove_first: product.vendor | strip }}</a></h3>
    <span class="pr num">{% if product.price_varies %}From {% endif %}{{ product.price | money }}</span>
    {%- render 'ck-stars', product: product -%}
  </div>
</article>
