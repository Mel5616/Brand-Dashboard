{%- comment -%} Quick links for existing stockists (asset library, catalogues, stockist finder). {%- endcomment -%}
{%- assign s = section.settings -%}
<section class="ck-sec ck-tradel"><div class="ck-wrap">
  <div class="ck-shead"><h2>{{ s.heading }}</h2>{%- if s.text != blank -%}<p>{{ s.text }}</p>{%- endif -%}</div>
  <div class="ck-tradel-grid">
    {%- for b in section.blocks -%}
      <a class="ck-tradel-card" href="{{ b.settings.url }}"{% if b.settings.url contains 'http' %} target="_blank" rel="noopener"{% endif %} {{ b.shopify_attributes }}>
        <b>{{ b.settings.title }}</b><span>{{ b.settings.text }}</span><em>{{ b.settings.cta }} →</em>
      </a>
    {%- endfor -%}
  </div>
</div></section>
{% schema %}
{ "name": "Trade quick links",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Already a stockist?" },
    { "type": "text", "id": "text", "label": "Text" } ],
  "blocks": [{ "type": "link", "name": "Link", "settings": [
    { "type": "text", "id": "title", "label": "Title" }, { "type": "text", "id": "text", "label": "Text" },
    { "type": "text", "id": "cta", "label": "Link label" }, { "type": "text", "id": "url", "label": "Link" } ] }],
  "presets": [{ "name": "Trade quick links" }] }
{% endschema %}
