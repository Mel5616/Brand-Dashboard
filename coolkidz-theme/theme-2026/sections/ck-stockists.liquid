{%- comment -%}
  Find a stockist. Data: assets/ck-stockists.json, built from Cin7 wholesale
  orders by scripts/coolkidz_stockists.py (brand-dashboard repo). Only suburb
  and postcode are shown. ?brand=Frida preselects a brand.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="ck-sec ck-stk" data-ck-stockists data-src="{{ 'ck-stockists.json' | asset_url }}"><div class="ck-wrap">
  <form class="ck-stk-bar" data-stk-form role="search">
    <label class="f"><span>Postcode or suburb</span><input class="ck-input" name="q" placeholder="e.g. 3121 or Richmond" autocomplete="postal-code"></label>
    <label class="f"><span>Brand</span><select class="ck-input" name="brand"><option value="">All brands</option></select></label>
    <button class="ck-btn" type="submit">Find stores</button>
    <button class="ck-link" type="button" data-stk-geo>Use my location</button>
  </form>
  <p class="ck-stk-status" data-stk-status aria-live="polite"></p>
  <div class="ck-stk-grid">
    <ol class="ck-stk-list" data-stk-list></ol>
    <div class="ck-stk-map" data-stk-map></div>
  </div>
  <div class="ck-stk-more">
    <div><h2>{{ s.national_heading }}</h2><div class="ck-stk-nat" data-stk-national></div></div>
    <div><h2>{{ s.online_heading }}</h2><ul class="ck-stk-online" data-stk-online></ul></div>
  </div>
</div></section>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js" defer></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  var root = document.querySelector('[data-ck-stockists]'); if (!root) return;
  var $ = function (q) { return root.querySelector(q); };
  var form = $('[data-stk-form]'), list = $('[data-stk-list]'), status = $('[data-stk-status]'), map, layer, data, here = null;
  function esc(t) { var d = document.createElement('div'); d.textContent = t == null ? '' : t; return d.innerHTML; }
  function km(a, b) { var r = Math.PI / 180, dLat = (b[0] - a[0]) * r, dLon = (b[1] - a[1]) * r, x = Math.sin(dLat / 2) * Math.sin(dLat / 2) + Math.cos(a[0] * r) * Math.cos(b[0] * r) * Math.sin(dLon / 2) * Math.sin(dLon / 2); return 12742 * Math.asin(Math.sqrt(x)); }
  function brandOk(x) { var b = form.brand.value; return !b || x.brands.indexOf(b) > -1; }
  function render() {
    var rows = data.stores.filter(brandOk).map(function (x) { return { x: x, d: here ? km(here, x.ll) : null }; });
    if (here) rows.sort(function (a, b) { return a.d - b.d; });
    else rows.sort(function (a, b) { return (b.x.wide ? 1 : 0) - (a.x.wide ? 1 : 0) || b.x.brands.length - a.x.brands.length; });
    var shown = here ? rows.slice(0, 30) : rows;
    list.innerHTML = shown.map(function (r, i) {
      var x = r.x, q = encodeURIComponent(x.name + ' ' + x.city + ' ' + x.state);
      return '<li data-i="' + i + '"><div class="t"><b>' + esc(x.name) + '</b>' + (x.pharmacy ? '<span class="tag">Pharmacy</span>' : '') + (x.wide ? '<span class="tag wide">Wide range</span>' : '') + '</div>' +
        '<div class="w">' + esc(x.city) + ' ' + esc(x.state) + ' ' + esc(x.postcode) + (r.d != null ? ' · ' + (r.d < 10 ? r.d.toFixed(1) : Math.round(r.d)) + ' km' : '') + '</div>' +
        '<div class="b">' + x.brands.map(esc).join(' · ') + '</div>' +
        '<a class="ck-link" href="https://www.google.com/maps/search/?api=1&query=' + q + '" target="_blank" rel="noopener">Directions</a></li>';
    }).join('') || '<li class="empty">No stores for that brand yet. Try the national and online retailers below, or <a href="/collections/all">buy it here</a>.</li>';
    status.textContent = (here ? 'Nearest ' + shown.length + ' of ' : '') + rows.length + ' store' + (rows.length === 1 ? '' : 's') + (form.brand.value ? ' stocking ' + form.brand.value : '') + '. Ranges vary, so call ahead.';
    var nat = data.national.filter(brandOk), onl = data.online.filter(brandOk);
    $('[data-stk-national]').innerHTML = nat.map(function (n) { return '<a href="' + esc(n.url) + '" target="_blank" rel="noopener"><b>' + esc(n.name) + '</b><small>' + n.brands.map(esc).join(' · ') + '</small></a>'; }).join('') || '<p>None for this brand.</p>';
    $('[data-stk-online]').innerHTML = onl.map(function (n) { var nm = '<b>' + esc(n.name) + '</b>'; return '<li>' + (n.web ? '<a href="' + esc(/^http/.test(n.web) ? n.web : 'https://' + n.web) + '" target="_blank" rel="noopener">' + nm + '</a>' : nm) + '<small>' + n.brands.map(esc).join(' · ') + '</small></li>'; }).join('') || '<li>None for this brand.</li>';
    if (window.L) {
      if (!map) {
        map = L.map($('[data-stk-map]'), { scrollWheelZoom: false }).setView([-28, 134], 4);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 18, attribution: '&copy; OpenStreetMap contributors' }).addTo(map);
      }
      if (layer) layer.remove();
      layer = L.layerGroup(shown.map(function (r) { return L.circleMarker(r.x.ll, { radius: 7, color: '#fff', weight: 2, fillColor: '#0B6A93', fillOpacity: 1 }).bindPopup('<b>' + esc(r.x.name) + '</b><br>' + esc(r.x.city) + ' ' + esc(r.x.state) + '<br><small>' + r.x.brands.map(esc).join(' · ') + '</small>'); })).addTo(map);
      if (here) { var pts = shown.slice(0, 8).map(function (r) { return r.x.ll; }).concat([here]); map.fitBounds(pts, { padding: [30, 30], maxZoom: 12 }); }
      else if (shown.length) map.fitBounds(shown.map(function (r) { return r.x.ll; }), { padding: [20, 20], maxZoom: 10 });
    }
  }
  list.addEventListener('click', function (e) { var li = e.target.closest('li[data-i]'); if (!li || e.target.closest('a') || !layer) return; var m = layer.getLayers()[+li.dataset.i]; if (m) { map.setView(m.getLatLng(), 12); m.openPopup(); } });
  form.addEventListener('submit', function (e) {
    e.preventDefault(); var q = form.q.value.trim(); if (!q) { here = null; render(); return; }
    status.textContent = 'Finding ' + q + '…';
    var local = data.stores.filter(function (x) { return x.postcode === q || x.city.toLowerCase() === q.toLowerCase(); })[0];
    if (local) { here = local.ll; render(); return; }
    fetch('https://nominatim.openstreetmap.org/search?format=json&limit=1&countrycodes=au&q=' + encodeURIComponent(q + ', Australia'))
      .then(function (r) { return r.json(); }).then(function (d) { if (!d.length) { status.textContent = "We couldn't find " + q + '. Try a postcode.'; return; } here = [+d[0].lat, +d[0].lon]; render(); })
      .catch(function () { status.textContent = "Search isn't available right now. Pick your state on the map instead."; });
  });
  form.brand.addEventListener('change', render);
  $('[data-stk-geo]').addEventListener('click', function () {
    if (!navigator.geolocation) return; status.textContent = 'Finding your location…';
    navigator.geolocation.getCurrentPosition(function (p) { here = [p.coords.latitude, p.coords.longitude]; render(); }, function () { status.textContent = 'Location is turned off. Type a postcode instead.'; });
  });
  fetch(root.getAttribute('data-src')).then(function (r) { return r.json(); }).then(function (d) {
    data = d;
    var all = {}; d.stores.concat(d.online, d.national).forEach(function (x) { x.brands.forEach(function (b) { all[b] = 1; }); });
    Object.keys(all).sort(function (a, b) { return a.toLowerCase() < b.toLowerCase() ? -1 : 1; }).forEach(function (b) { var o = document.createElement('option'); o.value = o.textContent = b; form.brand.appendChild(o); });
    var pb = new URLSearchParams(location.search).get('brand');
    if (pb) { var m = [].filter.call(form.brand.options, function (o) { return o.value.toLowerCase() === pb.toLowerCase(); })[0]; if (m) form.brand.value = m.value; }
    render();
  });
});
</script>
{% schema %}
{ "name": "Find a stockist",
  "settings": [
    { "type": "text", "id": "national_heading", "label": "National retailers heading", "default": "National retailers" },
    { "type": "text", "id": "online_heading", "label": "Online retailers heading", "default": "Online retailers" } ],
  "presets": [{ "name": "Find a stockist" }] }
{% endschema %}
