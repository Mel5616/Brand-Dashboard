{%- assign s = section.settings -%}
<section class="ck-hero"><div class="ck-wrap">
  <div class="top">
    <div class="hl">
      {%- if s.eyebrow != blank -%}<span class="ck-eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
      <h1>{{ s.heading | remove: '<p>' | remove: '</p>' }}</h1>
    </div>
    <div class="side">
      <p>{{ s.text }}</p>
      {%- assign pts = s.points | newline_to_br | split: '<br />' -%}
      {%- if s.points != blank -%}<ul class="pts">{%- for pt in pts -%}{%- assign t = pt | strip -%}{%- if t != blank -%}<li>{{ t }}</li>{%- endif -%}{%- endfor -%}</ul>{%- endif -%}
      <div class="ck-ctas">
        {%- if s.btn1_label != blank -%}<a class="ck-btn" href="{{ s.btn1_url }}">{{ s.btn1_label }}</a>{%- endif -%}
        {%- if s.btn2_label != blank -%}<a class="ck-link" href="{{ s.btn2_url }}">{{ s.btn2_label }}</a>{%- endif -%}
      </div>
    </div>
  </div>
  <div class="ck-trip">
    {%- for b in section.blocks -%}
      <figure {{ b.shopify_attributes }}>
        <a class="ph" href="{{ b.settings.url | default: '#' }}">{%- if forloop.first -%}{%- render 'ck-img', image: b.settings.image, asset: b.settings.asset, alt: b.settings.alt, width: 1000, eager: true -%}{%- else -%}{%- render 'ck-img', image: b.settings.image, asset: b.settings.asset, alt: b.settings.alt, width: 1000 -%}{%- endif -%}</a>
        <figcaption><span><b>{{ b.settings.brand }}</b>{% if b.settings.product != blank %} · {{ b.settings.product }}{% endif %}</span><span>{{ b.settings.moment }}</span></figcaption>
      </figure>
    {%- endfor -%}
  </div>
</div></section>
{% schema %}
{ "name": "Hero with three photos", "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Australian home of 12 premium baby brands" },
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>Shop UPPAbaby, Nanit, Gaia Baby and more, <em>all in one cart.</em></p>" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Coolkidz is the official Australian distributor behind UPPAbaby, Nanit, Gaia Baby, WonderFold, Frida, smarTrike and more, and has been for over 25 years. Now you can buy them all in one place, at the same price as each brand's own website." },
    { "type": "textarea", "id": "points", "label": "Key points (one per line)", "default": "Save 5% on two brands, 10% on three, 15% on four or more\nFree delivery Australia-wide on orders over $100\nGenuine Australian stock and full local warranty" },
    { "type": "text", "id": "btn1_label", "label": "Button", "default": "Shop all products" },
    { "type": "text", "id": "btn1_url", "label": "Button link", "default": "/collections/all" },
    { "type": "text", "id": "btn2_label", "label": "Second link", "default": "Meet the brands" },
    { "type": "text", "id": "btn2_url", "label": "Second link URL", "default": "/pages/our-brands" }
  ],
  "blocks": [{ "type": "photo", "name": "Photo", "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "asset", "label": "Fallback theme asset", "default": "ck-t1.jpg" },
    { "type": "text", "id": "alt", "label": "Alt text" },
    { "type": "text", "id": "brand", "label": "Brand" },
    { "type": "text", "id": "product", "label": "Product" },
    { "type": "text", "id": "moment", "label": "Moment" },
    { "type": "text", "id": "url", "label": "Link" } ] }],
  "presets": [{ "name": "Hero with three photos" }] }
{% endschema %}
