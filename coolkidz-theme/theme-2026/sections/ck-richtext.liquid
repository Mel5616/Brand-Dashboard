{%- comment -%} Readable text blocks for terms and policy-style pages. {%- endcomment -%}
<section class="ck-sec" style="padding-top:{{ section.settings.top }}px"><div class="ck-page">
  {%- for b in section.blocks -%}
    <div {{ b.shopify_attributes }} style="margin-bottom:28px">
      {%- if b.settings.heading != blank -%}<h2 style="font-size:clamp(24px,2.4vw,32px);margin-bottom:12px">{{ b.settings.heading }}</h2>{%- endif -%}
      <div class="ck-rte{% if b.settings.chips %} ck-chiplist{% endif %}">{{ b.settings.text }}</div>
    </div>
  {%- endfor -%}
</div></section>
{% schema %}
{ "name": "Text", "settings": [{ "type": "range", "id": "top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top space", "default": 0 }],
  "blocks": [{ "type": "text", "name": "Text", "settings": [{ "type": "text", "id": "heading", "label": "Heading" },{ "type": "richtext", "id": "text", "label": "Text" },{ "type": "checkbox", "id": "chips", "label": "Show list as chips", "default": false }] }],
  "presets": [{ "name": "Text" }] }
{% endschema %}
