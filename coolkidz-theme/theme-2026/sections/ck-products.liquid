{%- comment -%} A product grid with tabs, one tab per collection block. Tabs link through; the first collection shows here. {%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign first = s.collection -%}
<section class="ck-sec" id="{{ s.anchor | default: 'edit' }}"><div class="ck-wrap">
  <div class="ck-shead"><h2>{{ s.heading | remove: '<p>' | remove: '</p>' }}</h2><p>{{ s.text }}</p></div>
  {%- if section.blocks.size > 0 -%}
    <nav class="ck-chips" aria-label="Collections">
      <a class="ck-chip" href="{{ first.url | default: '/collections/all' }}" aria-current="true">{{ s.first_label }}</a>
      {%- for b in section.blocks -%}<a class="ck-chip" href="{{ b.settings.collection.url }}" {{ b.shopify_attributes }}>{{ b.settings.label | default: b.settings.collection.title }}</a>{%- endfor -%}
    </nav>
  {%- endif -%}
  <div class="ck-grid">
    {%- comment -%} In stock only, and at most per_brand from any one brand, so the grid reads as a mix. {%- endcomment -%}
    {%- if first != blank -%}{%- assign src = first -%}{%- else -%}{%- assign src = collections.all -%}{%- endif -%}
    {%- paginate src.products by 250 -%}{%- assign pool = src.products -%}
    {%- assign cap = s.per_brand | default: 1 -%}
    {%- assign shown = 0 -%}{%- assign seen = '|' -%}
    {%- for pass in (1..cap) -%}
      {%- for product in pool -%}
        {%- if shown >= s.limit -%}{%- break -%}{%- endif -%}
        {%- unless product.available and product.featured_media -%}{%- continue -%}{%- endunless -%}
        {%- assign key = '|' | append: product.id | append: '|' -%}
        {%- if seen contains key -%}{%- continue -%}{%- endif -%}
        {%- assign vcount = 0 -%}{%- for i in (1..pass) -%}{%- assign k = '|v' | append: i | append: ':' | append: product.vendor | append: '|' -%}{%- if seen contains k -%}{%- assign vcount = vcount | plus: 1 -%}{%- endif -%}{%- endfor -%}
        {%- if vcount >= pass -%}{%- continue -%}{%- endif -%}
        {%- assign seen = seen | append: product.id | append: '|v' | append: pass | append: ':' | append: product.vendor | append: '|' -%}
        {%- assign shown = shown | plus: 1 -%}
        {%- render 'ck-card', product: product -%}
      {%- endfor -%}
    {%- endfor -%}
    {%- endpaginate -%}
  </div>
  {%- if s.more_label != blank -%}<div class="ck-center"><a class="ck-btn line" href="{{ first.url | default: '/collections/all' }}">{{ s.more_label }}</a></div>{%- endif -%}
</div></section>
{% schema %}
{ "name": "Product grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The edit" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "A first look across the range. Every product is also sold on its brand's own Australian website, at the same price." },
    { "type": "collection", "id": "collection", "label": "Collection shown (blank for everything)" },
    { "type": "text", "id": "first_label", "label": "First chip label", "default": "Everything" },
    { "type": "range", "id": "limit", "min": 4, "max": 24, "step": 4, "label": "Products", "default": 8 },
    { "type": "range", "id": "per_brand", "min": 1, "max": 4, "step": 1, "label": "Most from one brand", "default": 1 },
    { "type": "text", "id": "more_label", "label": "Button", "default": "Shop everything" },
    { "type": "text", "id": "anchor", "label": "Anchor", "default": "edit" } ],
  "blocks": [{ "type": "tab", "name": "Collection link", "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "label", "label": "Tab label" } ] }],
  "presets": [{ "name": "Product grid" }] }
{% endschema %}
