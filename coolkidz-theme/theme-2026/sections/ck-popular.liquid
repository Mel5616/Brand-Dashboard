{%- comment -%} "Everyone's looking for": popular searches and shortcuts, above the footer. {%- endcomment -%}
{%- assign s = section.settings -%}
{%- unless template.name == 'cart' -%}
<section class="ck-popular"><div class="ck-wrap">
  <h2 class="ck-eyebrow">{{ s.heading }}</h2>
  <nav class="ck-popular-links" aria-label="{{ s.heading | escape }}">{%- render 'ck-links', text: s.links -%}</nav>
</div></section>
{%- endunless -%}
{% schema %}
{ "name": "Popular searches",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everyone's looking for" },
    { "type": "textarea", "id": "links", "label": "Links (Label | /url per line)", "default": "Stroller wagons | /collections/stroller-wagons\nUPPAbaby Vista V3 | /search?q=vista+v3&type=product\nNanit Pro camera | /search?q=nanit+pro&type=product\nSleep trainer clocks | /search?q=sleep+trainer&type=product\nWhite noise machines | /search?q=white+noise&type=product\nMagic nappy bins | /collections/nappy-bins\nCot beds | /search?q=cot+bed&type=product\nMiaMily suitcases | /collections/travel\nFrida hospital kit | /search?q=hospital+kit&type=product\nTeethers | /collections/teethers-and-toys\nHighchairs | /collections/feeding-and-highchairs\nBest sellers | /collections/best-sellers\nGift registry | /pages/gift-registry" } ],
  "presets": [{ "name": "Popular searches" }] }
{% endschema %}
