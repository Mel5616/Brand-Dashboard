{%- comment -%} What a brand partner sees each week. Figures are illustrative and labelled as such. {%- endcomment -%}
{%- assign s = section.settings -%}
<section class="ck-sec ck-tint-sky"><div class="ck-wrap" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:clamp(24px,5vw,80px);align-items:center">
  <div>
    <span class="ck-eyebrow">{{ s.eyebrow }}</span>
    <h2 style="font-size:clamp(34px,4.2vw,62px);margin-top:12px">{{ s.heading | remove: '<p>' | remove: '</p>' }}</h2>
    <div class="ck-rte" style="margin-top:18px;color:var(--soft)">{{ s.text }}</div>
  </div>
  <div class="ck-report" aria-label="Example weekly partner report">
    <div class="hd"><b>Weekly partner report</b><span class="ck-eyebrow">Example · figures illustrative</span></div>
    <div class="kpis">
      <div><b>$48.2k</b><span>Sales this week</span></div>
      <div><b>+12%</b><span>vs last week</span></div>
      <div><b>6.1</b><span>Weeks of stock</span></div>
      <div><b>4.8★</b><span>Review average</span></div>
    </div>
    <div class="bars">
      <div class="bar"><span>Your brand site</span><i style="width:88%;background:var(--blue)"></i><span class="num">41%</span></div>
      <div class="bar"><span>Retail partners</span><i style="width:70%;background:var(--green)"></i><span class="num">33%</span></div>
      <div class="bar"><span>Coolkidz shop</span><i style="width:30%;background:var(--pink)"></i><span class="num">14%</span></div>
      <div class="bar"><span>Events and expos</span><i style="width:26%;background:var(--red)"></i><span class="num">12%</span></div>
    </div>
    <p class="note">{{ s.note }}</p>
  </div>
</div></section>
{% schema %}
{ "name": "Partner report preview",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Reporting" },
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>You see what we see, <em>every week</em></p>" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Our own reporting platform pulls sales, stock, ads, email and reviews from every channel into one view. Partners get a clear weekly picture of how their brand is doing in Australia, and where the next opportunity is.</p>" },
    { "type": "text", "id": "note", "label": "Note under the example", "default": "Example layout. Real reports cover each partner's own channels and figures." } ],
  "presets": [{ "name": "Partner report preview" }] }
{% endschema %}
