{%- assign s = section.settings -%}
{%- assign v = product.selected_or_first_available_variant -%}
{%- assign vendor_clean = product.vendor | remove: ' Wagons Australia' | remove: ' Australia' -%}
<section class="ck-wrap" data-ck-product>
  <script type="application/json">{{ product | json }}</script>
  <nav class="ck-crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/collections/vendors?q={{ product.vendor | url_encode }}">{{ vendor_clean }}</a><span>/</span><span aria-current="page">{{ product.title | remove_first: product.vendor | strip | truncate: 48 }}</span></nav>
  <div class="ck-pdp">
    <div class="ck-gallery" data-ck-gallery>
      {%- assign n = 0 -%}
      {%- for m in product.media limit: 8 -%}
        {%- if m.media_type == 'image' -%}{%- assign n = n | plus: 1 -%}<div class="g">{%- assign ck_alt = m.alt | default: product.title -%}{%- if forloop.first -%}{{ m | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'high', alt: ck_alt, widths: '400,600,800,1000,1200', sizes: '(min-width: 900px) 55vw, 88vw' }}{%- else -%}{{ m | image_url: width: 1200 | image_tag: loading: 'lazy', alt: ck_alt, widths: '400,600,800,1000,1200', sizes: '(min-width: 900px) 55vw, 88vw' }}{%- endif -%}</div>{%- endif -%}
      {%- endfor -%}
    </div>
    {%- if n > 1 -%}<div class="ck-gdots" data-ck-gdots aria-hidden="true">{%- for i in (1..n) -%}<i{% if forloop.first %} class="on"{% endif %}></i>{%- endfor -%}</div>{%- endif -%}
    <div class="ck-buy">
      <a class="br" href="/collections/vendors?q={{ product.vendor | url_encode }}">{{ product.vendor | remove: ' Wagons Australia' | remove: ' Australia' }}</a>
      <h1>{{ product.title | remove_first: product.vendor | strip }}</h1>
      <div class="price num" data-ck-price>{{ v.price | money }}</div>
      {%- form 'product', product, data-ck-add: 'Added to your bag' -%}
        <input type="hidden" name="id" value="{{ v.id }}">
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <fieldset class="ck-opt" style="margin-bottom:14px"><legend>{{ option.name }}</legend><div class="vals">
              {%- for val in option.values -%}<label><input type="radio" name="opt-{{ forloop.parentloop.index }}" value="{{ val | escape }}"{% if option.selected_value == val %} checked{% endif %}><span>{{ val }}</span></label>{%- endfor -%}
            </div></fieldset>
          {%- endfor -%}
        {%- endunless -%}
        <div class="row" style="margin-top:6px">
          <div class="ck-qty"><button type="button" data-ck-step="-1" aria-label="One fewer">−</button><input name="quantity" value="1" inputmode="numeric" aria-label="Quantity"><button type="button" data-ck-step="1" aria-label="One more">+</button></div>
          <button class="ck-btn" type="submit" data-ck-atc{% unless v.available %} disabled{% endunless %}>{% if v.available %}Add to bag{% else %}Sold out{% endif %}</button>
        </div>
      {%- endform -%}
      {%- render 'ck-registry-button', product: product -%}
      {%- if settings.ck_mix_enabled -%}<div class="ck-mixnote">Mix brands and save: <b>{{ settings.ck_mix_2 }}%</b> off two brands, <b>{{ settings.ck_mix_3 }}%</b> off three, <b>{{ settings.ck_mix_4 }}%</b> off four or more.</div>{%- endif -%}
      <ul class="ck-perks">{%- assign lines = s.perks | newline_to_br | split: '<br />' -%}{%- for l in lines -%}{%- assign t = l | strip -%}{%- if t != '' -%}<li>{{ t }}</li>{%- endif -%}{%- endfor -%}</ul>
      <div class="ck-stickybar" data-ck-stickybar aria-hidden="true"><div><b>{{ product.title | remove_first: product.vendor | strip | truncate: 34 }}</b><span class="num" data-ck-price>{{ v.price | money }}</span></div><button class="ck-btn small" type="button" data-ck-sticky-add{% unless v.available %} disabled{% endunless %}>{% if v.available %}Add to bag{% else %}Sold out{% endif %}</button></div>
      <details class="ck-desc" open><summary>About this product</summary><div class="ck-rte">{{ product.description }}</div></details>
    </div>
  </div>
</section>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"Product","name":{{ product.title | json }},"brand":{"@type":"Brand","name":{{ vendor_clean | json }}},
 "description":{{ product.description | strip_html | truncate: 500 | json }},"url":{{ shop.url | append: product.url | json }},
 {% if product.featured_image %}"image":{{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }},{% endif %}
 {% if v.sku != blank %}"sku":{{ v.sku | json }},{% endif %}{% if v.barcode != blank %}"gtin":{{ v.barcode | json }},{% endif %}
 "offers":[{%- for vv in product.variants -%}{"@type":"Offer","price":{{ vv.price | divided_by: 100.0 | json }},"priceCurrency":{{ cart.currency.iso_code | json }},"availability":"https://schema.org/{% if vv.available %}InStock{% else %}OutOfStock{% endif %}","url":{{ shop.url | append: vv.url | json }}{% if vv.sku != blank %},"sku":{{ vv.sku | json }}{% endif %},"seller":{"@type":"Organization","name":"Coolkidz Australia"}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]}
</script>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":{{ shop.url | json }}},{"@type":"ListItem","position":2,"name":{{ vendor_clean | json }},"item":{{ shop.url | append: '/collections/vendors?q=' | append: product.vendor | json }}},{"@type":"ListItem","position":3,"name":{{ product.title | json }}}]}</script>
{% schema %}
{ "name": "Product",
  "settings": [{ "type": "textarea", "id": "perks", "label": "Reassurance points (one per line)", "default": "Official Australian stock, distributed by Coolkidz for over 25 years\nFull Australian warranty, supported at help.coolkidz.com.au\nSame price as the brand's own website" }] }
{% endschema %}
