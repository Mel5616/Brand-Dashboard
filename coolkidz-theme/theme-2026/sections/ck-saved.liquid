{%- comment -%} Saved for later. Filled in the browser from the handles ck-base.js keeps in localStorage. {%- endcomment -%}
<section class="ck-sec ck-saved"><div class="ck-wrap">
  <div class="ck-grid" data-ck-saved-grid></div>
  <div class="ck-saved-empty" data-ck-saved-empty hidden>
    <p>Nothing saved yet. Tap the heart on any product to keep it here while you decide.</p>
    <a class="ck-btn" href="/collections/best-sellers">Browse best sellers</a>
  </div>
  <p class="ck-saved-note">Saved items are kept on this device. To share a list with family, start a <a href="/pages/gift-registry">gift registry</a>.</p>
</div></section>
{% schema %}{ "name": "Saved for later" }{% endschema %}
