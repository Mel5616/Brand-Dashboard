{%- comment -%} Shop by category: a scrolling row of photo tiles, one per collection block. {%- endcomment -%}
{%- assign s = section.settings -%}
<section class="ck-sec ck-cats"><div class="ck-wrap">
  <div class="ck-shead"><h2>{{ s.heading }}</h2>{%- if s.text != blank -%}<p>{{ s.text }}</p>{%- endif -%}</div>
  <div class="ck-cats-row">
    {%- for b in section.blocks -%}
      {%- assign c = b.settings.collection -%}
      {%- if c == blank or c.products_count == 0 -%}{%- continue -%}{%- endif -%}
      {%- assign img = c.image -%}
      {%- if img == blank -%}{%- for p in c.products limit: 6 -%}{%- if p.available and p.featured_image -%}{%- assign img = p.featured_image -%}{%- break -%}{%- endif -%}{%- endfor -%}{%- endif -%}
      <a class="ck-cat" href="{{ c.url }}" {{ b.shopify_attributes }}>
        <span class="ph">{%- if img -%}{{ img | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200,300,400', sizes: '180px', alt: '' }}{%- endif -%}</span>
        <b>{{ b.settings.label | default: c.title }}</b>
      </a>
    {%- endfor -%}
  </div>
</div></section>
{% schema %}
{ "name": "Shop by category",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "text", "id": "text", "label": "Text" } ],
  "blocks": [{ "type": "category", "name": "Category", "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "label", "label": "Label (optional)" } ] }],
  "presets": [{ "name": "Shop by category" }] }
{% endschema %}
