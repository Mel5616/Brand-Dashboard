{%- comment -%}
  Journal: the latest Coolkidz articles, plus "From our brands' journals",
  links out to guides on the brand sites. Those links are refreshed by
  scripts/coolkidz_brand_feed.py in brand-dashboard.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign bl = s.blog | default: blogs.news -%}
<section class="ck-sec" id="journal"><div class="ck-wrap">
  {%- if s.show_own -%}
    <div class="ck-shead"><h2>{{ s.heading | remove: '<p>' | remove: '</p>' }}</h2><p>{{ s.text }}</p></div>
    <div class="ck-journal">
      {%- for a in bl.articles limit: 3 -%}
        <a class="ck-post" href="{{ a.url }}">
          <div class="ph">{%- if a.image -%}{{ a.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: a.title }}{%- endif -%}</div>
          <span class="ck-eyebrow">{{ a.tags.first | default: 'Guide' }}</span>
          <h3>{{ a.title }}</h3>
        </a>
      {%- endfor -%}
    </div>
  {%- endif -%}
  {%- if section.blocks.size > 0 -%}
    <div class="ck-shead" style="margin-top:{% if s.show_own %}clamp(48px,6vw,88px){% else %}0{% endif %}"><h2 style="font-size:clamp(28px,3.2vw,44px)">{{ s.feed_heading }}</h2><p>{{ s.feed_text }}</p></div>
    <div class="ck-feed">
      {%- for b in section.blocks -%}
        <a href="{{ b.settings.url }}" rel="noopener" {{ b.shopify_attributes }}>
          <div class="ph">{%- if b.settings.image_url != blank -%}<img src="{{ b.settings.image_url }}" alt="" loading="lazy">{%- endif -%}</div>
          <span>{{ b.settings.brand }}</span>
          <b>{{ b.settings.title }}</b>
        </a>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div></section>
{% schema %}
{ "name": "Journal",
  "settings": [
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "checkbox", "id": "show_own", "label": "Show Coolkidz articles", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Journal" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Guides for the first years from the Coolkidz team." },
    { "type": "text", "id": "feed_heading", "label": "Brand feed heading", "default": "From our brands' journals" },
    { "type": "textarea", "id": "feed_text", "label": "Brand feed text", "default": "The latest guides from each brand's own Australian website." } ],
  "blocks": [{ "type": "external", "name": "Brand article", "settings": [
    { "type": "text", "id": "brand", "label": "Brand" },
    { "type": "text", "id": "title", "label": "Title" },
    { "type": "text", "id": "url", "label": "Link" },
    { "type": "text", "id": "image_url", "label": "Image URL" } ] }],
  "presets": [{ "name": "Journal" }] }
{% endschema %}
