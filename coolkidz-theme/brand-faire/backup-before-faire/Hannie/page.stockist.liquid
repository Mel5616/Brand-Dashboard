<section style="background:var(--card);border-top:1px solid var(--line)"><div class="wrap">
  <p class="kick rv">The retail case</p>
  <h2 class="rv" style="margin-bottom:32px">Why retailers stock <em>Hannie</em></h2>
  <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px" class="cards3">
    <div class="rv" style="padding:24px;border:1px solid var(--line);border-radius:var(--radius)"><h3 style="margin-bottom:10px">A tight, premium range</h3><p style="color:var(--ink-soft);font-size:.95rem">Four SKUs, one silhouette. Easy to merchandise, easy to demo. It attaches to any sturdy chair in your store in under a minute.</p></div><div class="rv" style="padding:24px;border:1px solid var(--line);border-radius:var(--radius)"><h3 style="margin-bottom:10px">A growing category</h3><p style="color:var(--ink-soft);font-size:.95rem">Chair-mounted seats speak to small homes, café culture and travel, which is how modern Australian families actually eat.</p></div><div class="rv" style="padding:24px;border:1px solid var(--line);border-radius:var(--radius)"><h3 style="margin-bottom:10px">Local distribution</h3><p style="color:var(--ink-soft);font-size:.95rem">Melbourne warehouse, Australian compliance (tested to EN 16120 and AS/NZS 8124.3), 2-year warranty and marketing support from Coolkidz Australia.</p></div>
  </div>
</div></section>
<script>
document.addEventListener('DOMContentLoaded',()=>{
  const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.12});
  document.querySelectorAll('.rv').forEach((el,i)=>{el.style.transitionDelay=((i%3)*90)+'ms';io.observe(el)});
  // parallax engine: data-plx = speed factor; transforms relative to viewport centre
  const rm=matchMedia('(prefers-reduced-motion: reduce)').matches;
  const plx=[...document.querySelectorAll('[data-plx]')];
  if(!rm&&plx.length){let tick=false;
    const upd=()=>{tick=false;const vh=innerHeight;
      plx.forEach(el=>{const r=el.getBoundingClientRect();
        if(r.bottom<-100||r.top>vh+100)return;
        const c=(r.top+r.height/2-vh/2)/vh;
        el.style.transform='translateY('+(c*parseFloat(el.dataset.plx)*-120).toFixed(1)+'px)';});};
    addEventListener('scroll',()=>{if(!tick){tick=true;requestAnimationFrame(upd)}},{passive:true});upd();}
  // count-up stats: data-cnt = target number
  const cio=new IntersectionObserver(es=>es.forEach(e=>{if(!e.isIntersecting)return;cio.unobserve(e.target);
    const el=e.target,to=parseFloat(el.dataset.cnt),t0=performance.now();
    const step=n=>{const p=Math.min(1,(n-t0)/900),ease=1-Math.pow(1-p,3);
      el.textContent=Math.round(to*ease);if(p<1)requestAnimationFrame(step);};
    if(rm){el.textContent=to}else requestAnimationFrame(step);}),{threshold:.5});
  document.querySelectorAll('[data-cnt]').forEach(el=>cio.observe(el));
  // scroll-rise: .rise elements translate up + scale to full size as they enter the viewport
  const rise=[...document.querySelectorAll('.rise')];
  if(!rm&&rise.length){let rtick=false;
    const rupd=()=>{rtick=false;const vh=innerHeight;
      rise.forEach(el=>{const r=el.getBoundingClientRect();
        if(r.bottom<-50||r.top>vh+50)return;
        const p=Math.min(1,Math.max(0,(vh-r.top)/(vh*0.72)));
        el.style.transform='translateY('+((1-p)*9).toFixed(2)+'%) scale('+(0.94+p*0.06).toFixed(3)+')';});};
    addEventListener('scroll',()=>{if(!rtick){rtick=true;requestAnimationFrame(rupd)}},{passive:true});rupd();}
  // newsletter (static preview: becomes the Shopify customer form + Klaviyo sync at theme stage)
  const nl=document.getElementById('nl-form');
  if(nl){nl.addEventListener('submit',e=>{e.preventDefault();
    document.getElementById('nl-msg').style.display='block';});}
  // reading progress bar
  const pb=document.createElement('div');pb.id='pbar';document.body.appendChild(pb);
  const pup=()=>{const m=document.documentElement.scrollHeight-innerHeight;
    pb.style.width=(m>0?Math.min(100,scrollY/m*100):0)+'%';};
  addEventListener('scroll',pup,{passive:true});pup();
  const b=document.querySelector('.burger'),d=document.querySelector('.drawer'),s=document.querySelector('.scrim');
  if(b){b.onclick=()=>{d.classList.add('open');s.classList.add('show')};
    s.onclick=()=>{d.classList.remove('open');s.classList.remove('show')};
    d.querySelector('.dx').onclick=s.onclick;}
  const bar=document.querySelector('.buybar');
  if(bar){const sent=document.querySelector('#buy-sentinel');
    if(sent){new IntersectionObserver(es=>es.forEach(e=>bar.classList.toggle('show',!e.isIntersecting)),{threshold:0}).observe(sent);}
    else{window.addEventListener('scroll',()=>bar.classList.toggle('show',window.scrollY>600),{passive:true});}}
});
</script>