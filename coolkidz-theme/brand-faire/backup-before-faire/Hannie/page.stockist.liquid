<style>
:root{
  --paper:#F7F4EE; --card:#FFFFFF; --ink:#231F20; --ink-soft:#6B6558;
  --sage:#8E9C80; --sage-deep:#5F6E54; --sage-wash:#EDF0E8;
  --sand:#E9E2D3; --sand-deep:#D8CDB6; --clay:#7E3B2F; --charcoal:#231F20;
  --line:#E4DED2; --radius:0px;
  --disp:'Euclid Circular B','DM Sans',-apple-system,'Helvetica Neue',sans-serif;
  --body:'Euclid Circular B','DM Sans',-apple-system,'Helvetica Neue',sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:var(--body);color:var(--ink);background:var(--paper);line-height:1.65;font-size:16.5px;-webkit-font-smoothing:antialiased}
img{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
.wrap{max-width:1200px;margin:0 auto;padding:0 24px}
.wrap-n{max-width:880px;margin:0 auto;padding:0 24px}
h1,h2,h3,.disp{font-family:var(--disp);font-weight:600;line-height:1.08;letter-spacing:-.025em}
h1{font-size:clamp(2.3rem,5vw,4rem)}
h2{font-size:clamp(1.8rem,3.4vw,2.7rem)}
h3{font-size:1.3rem;font-weight:600;letter-spacing:-.01em}
em,.it{font-style:normal;color:var(--sage-deep)}
.ondark em{color:#C9D4BC}
.kick{font-size:.9rem;letter-spacing:.01em;color:var(--sage-deep);font-weight:700;margin-bottom:14px}
.lead{font-size:1.15rem;color:var(--ink-soft);max-width:56ch}
.btn{display:inline-flex;align-items:center;gap:10px;background:var(--ink);color:#fff;border:1px solid var(--ink);
  padding:15px 30px;border-radius:0;font-weight:600;font-size:.95rem;transition:.25s;cursor:pointer}
.btn:hover{background:var(--sage-deep);border-color:var(--sage-deep);transform:translateY(-1px)}
.btn.ghost{background:transparent;color:var(--ink)}
.btn.ghost:hover{background:var(--ink);color:#fff}
.btn.light{background:#fff;color:var(--ink);border-color:#fff}
.btn.light:hover{background:var(--sand);border-color:var(--sand);color:var(--ink)}
section{padding:88px 0}
.tick{background:var(--ink);color:#F1EEE6;font-size:.8rem;letter-spacing:.06em;text-align:center;padding:9px 16px}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
#pbar{position:fixed;top:0;left:0;height:3px;background:var(--sage-deep);width:0;z-index:99;transition:width .15s linear}
/* form fields */
.fl{display:block;font-weight:600;font-size:.9rem}
.fl input,.fl select,.fl textarea{display:block;width:100%;margin-top:7px;padding:13px 16px;border:1px solid var(--line);
  border-radius:0;font-size:1rem;font-family:var(--body);background:var(--paper);color:var(--ink)}
.fl input:focus,.fl select:focus,.fl textarea:focus{outline:2px solid var(--sage);border-color:var(--sage)}
.fl textarea{resize:vertical}
.tick a{text-decoration:underline;text-underline-offset:3px}

/* header */
header.site{position:sticky;top:0;z-index:60;background:rgba(247,244,238,.92);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.nav{display:flex;align-items:center;justify-content:space-between;height:72px;gap:20px}
.nav .logo{flex:none}
.nav .logo img{height:26px;width:auto;max-width:none}
.nav ul{display:flex;gap:30px;list-style:none}
.nav ul a{font-weight:600;font-size:.93rem;color:var(--ink-soft);transition:.2s}
.nav ul a:hover,.nav ul a.on{color:var(--ink)}
.nav .cta{background:var(--ink);color:#fff;padding:10px 22px;border-radius:0;font-weight:600;font-size:.9rem;transition:.25s;white-space:nowrap}
.nav .cta:hover{background:var(--sage-deep)}
.burger{display:none;background:none;border:none;cursor:pointer;padding:8px}
.burger span{display:block;width:22px;height:2px;background:var(--ink);margin:5px 0;border-radius:2px}
.drawer{position:fixed;inset:0 0 0 auto;width:min(340px,88vw);background:var(--paper);z-index:90;transform:translateX(105%);transition:.35s cubic-bezier(.4,0,.2,1);padding:28px;box-shadow:-20px 0 60px rgba(0,0,0,.18);display:flex;flex-direction:column}
.drawer.open{transform:none}
.drawer a.dl{font-family:var(--disp);font-size:1.5rem;padding:13px 0;border-bottom:1px solid var(--line)}
.scrim{position:fixed;inset:0;background:rgba(38,36,31,.45);opacity:0;pointer-events:none;transition:.3s;z-index:80}
.scrim.show{opacity:1;pointer-events:auto}

/* footer */
footer.site{background:var(--charcoal);color:#CFC9BC;padding:70px 0 40px;position:relative;overflow:hidden}
footer.site .wrap{position:relative;z-index:1}
footer.site h4{color:#fff;font-size:.82rem;letter-spacing:.16em;text-transform:uppercase;margin-bottom:16px}
footer.site a{color:#CFC9BC;font-size:.92rem;display:block;padding:4px 0;transition:.2s}
footer.site a:hover{color:#fff}
.fgrid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:40px}
.fbase{border-top:1px solid rgba(255,255,255,.14);margin-top:48px;padding-top:24px;font-size:.82rem;color:#96917F;display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}

/* helpers */
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center}
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden}
.rv{opacity:0;transform:translateY(26px);transition:opacity .7s ease,transform .7s ease}
.rv.in{opacity:1;transform:none}
.swatch{width:34px;height:34px;border-radius:50%;border:2px solid transparent;outline:2px solid transparent;outline-offset:3px;cursor:pointer;transition:.2s;flex:none}
.swatch.on{outline-color:var(--ink)}
.pill{display:inline-block;background:var(--sage-wash);color:var(--sage-deep);border-radius:0;padding:6px 16px;font-size:.82rem;font-weight:700;letter-spacing:.04em}
.buybar{position:fixed;left:0;right:0;bottom:0;z-index:55;background:rgba(255,255,255,.95);backdrop-filter:blur(12px);border-top:1px solid var(--line);padding:12px 0;transform:translateY(110%);transition:.35s}
.buybar.show{transform:none}
.buybar .in{display:flex;align-items:center;justify-content:space-between;gap:16px}
.buybar img{width:46px;height:46px;object-fit:cover;border-radius:0}
/* media proportion helpers: square frame, cover-cropped: no letterbox bars, no stretch */
.ph{aspect-ratio:1/1;display:block;position:relative;overflow:hidden;background:#F0EFEB}
.ph>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.zoom>img{transition:transform .6s cubic-bezier(.22,.61,.36,1)}
.zoom:hover>img{transform:scale(1.05)}
.card .cimg{overflow:hidden}
.card .cimg img{transition:transform .7s cubic-bezier(.22,.61,.36,1)}
.card:hover .cimg img{transform:scale(1.05)}
/* parallax + marquee */
[data-plx]{will-change:transform}
.plx-wrap{overflow:hidden;position:relative}
.marq{overflow:hidden;white-space:nowrap;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:20px 0;background:var(--card)}
.marq .mi{display:inline-block;animation:marq 30s linear infinite;font-family:var(--disp);font-size:1.5rem;color:var(--ink-soft)}
.marq .mi em{color:var(--sage-deep)}
@keyframes marq{to{transform:translateX(-50%)}}
/* all-ages stage: cropped to the kids, image rises in on scroll */
.ages-stage{position:relative;overflow:hidden;height:56vh;min-height:340px;margin-top:34px}
.ages-stage img{width:100%;height:100%;object-fit:cover;object-position:center 85%;will-change:transform}
@media(max-width:700px){.ages-stage{height:62vh;margin-top:24px}.ages-stage img{object-position:center top}}
/* milestones timeline: horizontal scroll-snap */
.tl{display:flex;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;padding:28px 24px 36px;
  max-width:1200px;margin:0 auto;scrollbar-width:thin;scrollbar-color:var(--sage) transparent}
.tl-c{flex:0 0 300px;scroll-snap-align:start;background:var(--card);border:1px solid var(--line);padding:24px}
.tl-arrow{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:52px;height:52px;border-radius:50%;
  border:none;cursor:pointer;background:rgba(255,255,255,.95);color:var(--ink);
  display:flex;align-items:center;justify-content:center;box-shadow:0 8px 30px rgba(0,0,0,.18);transition:.25s}
.tl-arrow:hover{background:var(--sage-deep);color:#fff}
.tl-arrow[disabled]{opacity:.25;pointer-events:none}
.tl-c:nth-child(even){background:var(--sage-wash);border-color:transparent}
/* hero entrance choreography (index) */
@keyframes hupY{from{transform:translateY(112%)}to{transform:none}}
@keyframes hupF{from{opacity:0;transform:translateY(26px)}to{opacity:1;transform:none}}
.hup1{animation:hupF .7s .15s cubic-bezier(.22,.61,.36,1) both}
.hup2{animation:hupY .95s .3s cubic-bezier(.22,.61,.36,1) both}
.hup3{animation:hupF .7s .6s cubic-bezier(.22,.61,.36,1) both}
.hup4{animation:hupF .7s .8s cubic-bezier(.22,.61,.36,1) both}
/* fit-checker success celebration */
.tk-c{stroke-dasharray:183;stroke-dashoffset:183;animation:tkdash .6s .1s ease-out forwards}
.tk-t{stroke-dasharray:40;stroke-dashoffset:40;animation:tkdash .45s .55s ease-out forwards}
@keyframes tkdash{to{stroke-dashoffset:0}}
.pop{animation:pop .55s cubic-bezier(.34,1.56,.64,1)}
@keyframes pop{from{transform:scale(.94);opacity:.4}}
/* PDP gallery hover-swap */
.pgal .alt{opacity:0;transition:opacity .45s ease}
.pgal .card:hover .alt{opacity:1}
@media(prefers-reduced-motion:reduce){.hup1,.hup2,.hup3,.hup4,.tk-c,.tk-t,.pop{animation:none}.tk-c,.tk-t{stroke-dashoffset:0}}
/* two-column FAQ stacks */
.fq2{display:grid;grid-template-columns:1fr 1fr;gap:0 44px;align-items:start}
.fq2 details{border-bottom:1px solid var(--line)}
.fq2 summary{cursor:pointer;font-weight:600;padding:17px 0;font-size:1.02rem;list-style-position:outside}
.fq2 details p{color:var(--ink-soft);padding:0 0 18px}
/* PDP gallery grid */
.pgal{display:grid;grid-template-columns:1fr 1fr;gap:14px;transition:opacity .25s}
.pgal .g-wide{grid-column:1/-1}
.pgrid{grid-template-columns:1.35fr 1fr}
@media(max-width:900px){.pgrid{grid-template-columns:1fr}}
/* scrollytelling */
.scrolly{display:grid;grid-template-columns:1.05fr 1fr;gap:60px;align-items:start}
.s-sticky{position:sticky;top:96px}
.gimg{opacity:0;transition:opacity .5s ease}
.gimg.on{opacity:1}
.gstep{min-height:58vh;display:flex;flex-direction:column;justify-content:center;opacity:.28;transition:opacity .45s}
.gstep.on{opacity:1}
.gdots{display:flex;gap:8px;justify-content:center;margin-top:16px}
.gdots i{width:8px;height:8px;border-radius:50%;background:var(--line);transition:.3s}
.gdots i.on{background:var(--sage-deep);transform:scale(1.25)}
@media(max-width:560px){.nav .cta{display:none}.nav .logo img{height:23px}}
@media(max-width:900px){
  .nav ul{display:none}.burger{display:block}
  .grid2{grid-template-columns:1fr;gap:32px}
  .fgrid{grid-template-columns:1fr 1fr}
  section{padding:60px 0}
  /* single column: flatten the text cell so .s-sticky can stick across the whole grid */
  .scrolly{grid-template-columns:1fr;gap:18px}
  .scrolly>div:last-child{display:contents}
  .s-sticky{position:sticky;top:76px;z-index:2}
  .s-sticky .ph{aspect-ratio:auto;height:38vh}
  .s-sticky .gdots{margin-top:10px}
  .gstep{min-height:52vh}
  .fq2{grid-template-columns:1fr}
}
@media(prefers-reduced-motion:reduce){
  .rv{opacity:1!important;transform:none!important;transition:none!important}
  [data-plx]{transform:none!important}
  .marq .mi{animation:none}
  .zoom:hover>img,.card:hover .cimg img{transform:none}
}
@media(max-width:900px){.cards3{grid-template-columns:1fr!important}}</style>
