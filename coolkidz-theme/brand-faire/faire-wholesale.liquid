{%- comment -%}
  Wholesale on Faire panel (Coolkidz). Self-contained: works in any theme.
  render 'faire-wholesale', brand: 'Frida', url: 'https://www.faire.com/brand/...', image: 'faire-wholesale.jpg'
{%- endcomment -%}
{%- assign fw_img = image | default: 'faire-wholesale.jpg' -%}
<style>
  .fw{padding:56px 20px;box-sizing:border-box}
  .fw *{box-sizing:border-box}
  .fw-card{max-width:1180px;margin:0 auto;display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);background:#fff;border-radius:20px;overflow:hidden;box-shadow:0 22px 50px -32px rgba(0,0,0,.4);color:#1f1f1f;text-align:left}
  .fw-tx{padding:clamp(28px,4vw,56px);display:flex;flex-direction:column;gap:18px}
  .fw-lock{display:flex;align-items:center;gap:12px;margin:0;font-size:20px;line-height:1.2}
  .fw-lock b{font-weight:700}.fw-lock i{font-style:normal;color:#8a8a8a}
  .fw-lock span{font-family:Georgia,'Times New Roman',serif;letter-spacing:.38em;font-size:18px}
  .fw h2{margin:0;font-size:clamp(28px,3.2vw,44px);line-height:1.1;letter-spacing:-.01em;color:#1f1f1f}
  .fw-lede{margin:0;font-size:16px;line-height:1.55;color:#4a4a4a}
  .fw ul{list-style:none;margin:0;padding:0;display:grid;gap:12px}
  .fw li{position:relative;padding-left:32px;font-size:16px;line-height:1.45;font-weight:500}
  .fw li:before{content:"";position:absolute;left:2px;top:4px;width:14px;height:8px;border-left:2px solid #1f1f1f;border-bottom:2px solid #1f1f1f;transform:rotate(-45deg)}
  .fw-btn{display:block;text-align:center;background:#2f2f2f;color:#fff!important;text-decoration:none!important;border-radius:6px;padding:18px 24px;font-size:17px;font-weight:600;margin-top:8px}
  .fw-btn:hover{background:#000}
  .fw-fine{margin:0;font-size:13px;color:#6b6b6b;line-height:1.5}
  .fw-ph{position:relative;min-height:440px}
  .fw-ph img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
  @media (max-width:800px){.fw-card{grid-template-columns:1fr}.fw-ph{min-height:0;aspect-ratio:3/2;order:-1}}
</style>
<section class="fw" id="wholesale">
  <div class="fw-card">
    <div class="fw-tx">
      <p class="fw-lock"><b>{{ brand }}</b><i>×</i><span>FAIRE</span></p>
      <h2>Stock {{ brand }} in your store</h2>
      <p class="fw-lede">Baby stores, pharmacies, clinics, childcare centres and gift shops can order {{ brand }} wholesale on Faire, in small quantities and with no trade account needed.</p>
      <ul>
        <li>Low order minimums, so you can try the range without a big commitment</li>
        <li>Payment terms for eligible retailers</li>
        <li>Free returns on your first order</li>
      </ul>
      <a class="fw-btn" href="{{ url }}" target="_blank" rel="noopener">Shop {{ brand }} wholesale on Faire</a>
      <p class="fw-fine">Offers and payment terms are set by Faire and depend on eligibility. For larger orders or national accounts, contact Coolkidz Australia, the Australian distributor of {{ brand }}, at <a href="https://coolkidz.com.au/pages/become-a-stockist">coolkidz.com.au</a>.</p>
    </div>
    <div class="fw-ph"><img src="{{ fw_img | asset_url }}" alt="{{ brand }}" loading="lazy" width="1000" height="1000"></div>
  </div>
</section>
